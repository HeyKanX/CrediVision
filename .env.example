# Conexión local mediante autenticación de Windows.
SQL_AUTHENTICATION=windows
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER=HEYKAN
SQL_DATABASE=credivision
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes

# Define una clave larga y aleatoria para conservar sesiones tras reiniciar Flask.
FLASK_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
